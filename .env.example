# Get these from https://dashboard.plaid.com/team/keys
# Sandbox client_id + secret are issued instantly, no approval needed.
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# sandbox | development | production
PLAID_ENV=sandbox

# Local port for the server
PORT=8080

# Comma-separated list of country codes Link should support
PLAID_COUNTRY_CODES=US

# Optional: set once you're testing OAuth institutions (Chase, Wells Fargo, etc.)
# Must be registered in the Plaid Dashboard under Team Settings > API > Allowed redirect URIs.
# PLAID_REDIRECT_URI=http://localhost:8080/
